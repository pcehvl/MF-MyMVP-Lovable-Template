{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "product-assistant",
  "mcp": {
    "servers": {
      "lovable": {
        "type": "remote",
        "url": "https://mcp.lovable.dev"
      }
    }
  },
  "agents": {
    "build": {
      "permissions": [
        { "action": "lovable_*", "resource": "*", "effect": "deny" }
      ]
    },
    "plan": {
      "permissions": [
        { "action": "lovable_*", "resource": "*", "effect": "deny" }
      ]
    },
    "general": {
      "permissions": [
        { "action": "lovable_*", "resource": "*", "effect": "deny" }
      ]
    },
    "explore": {
      "permissions": [
        { "action": "lovable_*", "resource": "*", "effect": "deny" }
      ]
    },
    "compaction": {
      "permissions": [
        { "action": "lovable_*", "resource": "*", "effect": "deny" }
      ]
    }
  }
}
